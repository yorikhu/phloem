{
  "name": "@phloem/mcp",
  "version": "0.1.0",
  "description": "Phloem MCP Server — Model Context Protocol server for AI agent integration",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "phloem-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@phloem/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
