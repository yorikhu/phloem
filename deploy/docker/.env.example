# ============================================================
# Phloem — Environment Configuration
#
# 快速启动（Lite 模式，~8GB RAM）：
#   cp .env.example .env
#   docker compose up -d --wait
#
# 查看服务状态：
#   docker compose ps
#   ./deploy/scripts/healthcheck.sh
# ============================================================

# ── Document Engine ──────────────────────────────────────
# Available: infinity (default, Lite ~8GB) | elasticsearch (full ~16GB)
DOC_ENGINE=infinity

# ── Device ───────────────────────────────────────────────
# Available: cpu (default) | gpu
DEVICE=cpu

# ── Metadata DB ──────────────────────────────────────────
DB_TYPE=mysql

# ── Phloem Gateway ───────────────────────────────────────
PHLOEM_PORT=3000
PHLOEM_LOG_LEVEL=info
PHLOEM_CORS_ORIGINS=*
PHLOEM_ADAPTER_TYPE=mock   # mock | ragflow

# ── RAGFlow ───────────────────────────────────────────────
RAGFLOW_PORT=9380
ADMIN_SVR_HTTP_PORT=9381
# Get from RAGFlow Web UI → Settings → API Keys
PHLOEM_RAGFLOW_API_KEY=

# ── MySQL (infra, auto-started with DOC_ENGINE=infinity) ──
EXPOSE_MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=infini_rag_flow
MYSQL_DATABASE=rag_flow
MYSQL_USER=rag_flow
MYSQL_PASSWORD=infini_rag_flow

# ── Redis (infra) ─────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=infini_rag_flow

# ── MinIO / Object Storage (infra) ────────────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USER=rag_flow
MINIO_PASSWORD=infini_rag_flow

# ── Infinity (DOC_ENGINE=infinity) ───────────────────────
INFINITY_HTTP_PORT=23820
INFINITY_THRIFT_PORT=23817

# ── Web UI ───────────────────────────────────────────────
WEB_PORT=5173
# mock: use MSW mock handlers (no backend needed)
# real: call gateway API (requires gateway + ragflow running)
VITE_API_MODE=mock

# ── RAGFlow Image ─────────────────────────────────────────
# Use official pre-built image (recommended for first run)
RAGFLOW_IMAGE=infiniflow/ragflow:v0.26.4
# For China mainland (alternative registry):
# RAGFLOW_IMAGE=swr.cn-north-4.myhuaweicloud.com/infiniflow/ragflow:v0.26.4

# ── Timezone ──────────────────────────────────────────────
TZ=Asia/Shanghai
